# Aurora PostgreSQL Serverless v2 for LangGraph checkpointer.
#
# LangGraph uses PostgresSaver to persist graph state between turns and
# across sessions. Aurora Serverless v2 scales to zero when idle (dev only),
# so there's no cost when no agent is running.
#
# Credentials are generated by RDS and stored in Secrets Manager — the agent
# reads them at startup, no hard-coded passwords anywhere.

# ── Security group ─────────────────────────────────────────────────────────────

resource "aws_security_group" "aurora" {
  name        = "${var.cluster_name}-aurora-sg"
  description = "Aurora PostgreSQL for LangGraph"
  vpc_id      = aws_vpc.this.id

  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.nodes.id]
    description     = "Allow PostgreSQL from EKS nodes"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound"
  }

  tags = { Name = "${var.cluster_name}-aurora-sg", ManagedBy = "terraform" }
}

# ── Subnet group (Aurora must span multiple AZs) ──────────────────────────────

resource "aws_db_subnet_group" "aurora" {
  name        = "${var.cluster_name}-aurora-subnet-group"
  description = "Private subnets for Aurora"
  subnet_ids  = aws_subnet.private[*].id

  tags = { ManagedBy = "terraform" }
}

# ── Password in Secrets Manager ────────────────────────────────────────────────

resource "aws_secretsmanager_secret" "db_password" {
  name                    = "/${var.cluster_name}/aurora/master-password"
  description             = "Aurora master password for LangGraph database"
  recovery_window_in_days = 7

  tags = { ManagedBy = "terraform", Environment = "dev" }
}

resource "aws_secretsmanager_secret_version" "db_password" {
  secret_id = aws_secretsmanager_secret.db_password.id
  secret_string = jsonencode({
    username = "langgraph_admin"
    password = random_password.db.result
    host     = aws_rds_cluster.aurora.endpoint
    port     = 5432
    dbname   = var.db_name
  })
}

resource "random_password" "db" {
  length  = 32
  special = false # avoid characters that break connection strings
}

# ── Aurora Serverless v2 cluster ───────────────────────────────────────────────

resource "aws_rds_cluster" "aurora" {
  cluster_identifier      = "${var.cluster_name}-langgraph"
  engine                  = "aurora-postgresql"
  engine_mode             = "provisioned"
  engine_version          = "16.4"
  database_name           = var.db_name
  master_username         = "langgraph_admin"
  master_password         = random_password.db.result
  db_subnet_group_name    = aws_db_subnet_group.aurora.name
  vpc_security_group_ids  = [aws_security_group.aurora.id]
  storage_encrypted       = true
  deletion_protection     = false # dev only — set true for prod
  skip_final_snapshot     = true  # dev only
  backup_retention_period = 1

  serverlessv2_scaling_configuration {
    min_capacity = 0.5 # scales to zero when idle
    max_capacity = 4
  }

  tags = { ManagedBy = "terraform", Environment = "dev", Purpose = "langgraph-checkpointer" }
}

resource "aws_rds_cluster_instance" "aurora" {
  cluster_identifier   = aws_rds_cluster.aurora.id
  instance_class       = "db.serverless"
  engine               = aws_rds_cluster.aurora.engine
  engine_version       = aws_rds_cluster.aurora.engine_version
  db_subnet_group_name = aws_db_subnet_group.aurora.name

  tags = { ManagedBy = "terraform" }
}
